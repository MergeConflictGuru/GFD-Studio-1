<Project>
  <!--
    The checked-in Scarlet and TGA projects are legacy .NET Framework projects.
    They only define AnyCPU/x86 configurations, while the x64 GFD Studio build
    passes Platform=x64 through the project-reference graph. Give those projects
    a valid output directory for that CI configuration without changing their
    managed assembly architecture.
  -->
  <PropertyGroup Condition="'$(Platform)' == 'x64' and ('$(MSBuildProjectName)' == 'Scarlet' or '$(MSBuildProjectName)' == 'Scarlet.IO.ImageFormats' or '$(MSBuildProjectName)' == 'TgaDecoderTest')">
    <BaseOutputPath>bin\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64' and ('$(MSBuildProjectName)' == 'GFDLibrary' or '$(MSBuildProjectName)' == 'GFDLibrary.Rendering.OpenGL')">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
