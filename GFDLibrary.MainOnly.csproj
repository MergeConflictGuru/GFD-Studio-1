<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <AssemblyName>GFDLibrary</AssemblyName>
    <RootNamespace>GFDLibrary</RootNamespace>
    <Version>0.10.3</Version>
    <Authors>TGE</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GFDLibrary\**\*.cs" Exclude="GFDLibrary\bin\**;GFDLibrary\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BCnEncoder">
      <HintPath>GFDStudio-binary\BCnEncoder.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="BCnEncoder.NET.ImageSharp">
      <HintPath>GFDStudio-binary\BCnEncoder.NET.ImageSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CSharpImageLibrary">
      <HintPath>GFDStudio-binary\CSharpImageLibrary.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.IO.RecyclableMemoryStream">
      <HintPath>GFDStudio-binary\Microsoft.IO.RecyclableMemoryStream.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Toolkit.HighPerformance">
      <HintPath>GFDStudio-binary\Microsoft.Toolkit.HighPerformance.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Scarlet">
      <HintPath>GFDStudio-binary\Scarlet.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Scarlet.IO.ImageFormats">
      <HintPath>GFDStudio-binary\Scarlet.IO.ImageFormats.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SixLabors.ImageSharp">
      <HintPath>GFDStudio-binary\SixLabors.ImageSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Drawing.Common">
      <HintPath>GFDStudio-binary\System.Drawing.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="TgaDecoderTest">
      <HintPath>GFDStudio-binary\TgaDecoderTest.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UsefulThings">
      <HintPath>GFDStudio-binary\UsefulThings.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="YamlDotNet">
      <HintPath>GFDStudio-binary\YamlDotNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
