#!/bin/sh

# Git invokes post-push after the remote accepts the push. For every pushed
# branch that changes build inputs, wait for that exact commit's Actions run
# and fetch its artifact.
repo_root=$(git rev-parse --show-toplevel) || exit 1
fetch_script="$repo_root/fetch-latest-build.ps1"

if [ ! -f "$fetch_script" ]; then
    echo "GFD Studio: fetch-latest-build.ps1 was not found." >&2
    exit 1
fi

# Git for Windows runs this shell through MSYS, so paths on non-C: drives can
# look like /mnt/q/... to the shell. Windows PowerShell needs the native path.
if command -v cygpath >/dev/null 2>&1; then
    fetch_script=$(cygpath -w "$fetch_script") || exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/heads/*)
            case "$local_sha" in
                0000000000000000000000000000000000000000) continue ;;
            esac

            branch=${local_ref#refs/heads/}
            powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass \
                -File "$fetch_script" \
                -Branch "$branch" \
                -Commit "$local_sha" \
                -SourceCommit "$remote_sha"
            if [ $? -ne 0 ]; then
                exit 1
            fi
            ;;
    esac
done
